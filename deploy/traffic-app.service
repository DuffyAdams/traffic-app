[Unit]
Description=Traffic Alerts App backend and scraper
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/projects/san-diego-traffic-watch
EnvironmentFile=/home/ubuntu/projects/san-diego-traffic-watch/.env
Environment=TRAFFIC_APP_HOST=127.0.0.1
Environment=TRAFFIC_APP_PORT=5002
Environment=TZ=America/Los_Angeles
ExecStart=/home/ubuntu/projects/san-diego-traffic-watch/venv/bin/python /home/ubuntu/projects/san-diego-traffic-watch/traffic_scraper.py
Restart=always
RestartSec=5
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
